diff --git a/prophesee_ros_driver/src/prophesee_ros_stereo_publisher.cpp b/prophesee_ros_driver/src/prophesee_ros_stereo_publisher.cpp
new file mode 100644
index 0000000..6751e4f
--- /dev/null
+++ b/prophesee_ros_driver/src/prophesee_ros_stereo_publisher.cpp
@@ -0,0 +1,159 @@
+/*******************************************************************
+ * File : prophesee_ros_stereo_publisher.cpp                       *
+ *******************************************************************/
+
+#include <thread>
+
+#include <ros/ros.h>
+
+#include <dvs_msgs/Event.h>
+#include <dvs_msgs/EventArray.h>
+
+#include "prophesee_ros_stereo_publisher.h"
+
+PropheseeStereoPublisher::PropheseeStereoPublisher() : nh_("~") {
+    left_.camera_name  = "left";
+    right_.camera_name = "right";
+
+    nh_.getParam("left_serial", left_.serial_number);
+    nh_.getParam("right_serial", right_.serial_number);
+
+    publish_cd_ = true;
+    nh_.getParam("publish_cd", publish_cd_);
+    event_delta_t_ = ros::Duration(nh_.param<double>("event_delta_t", 100.0e-6));
+
+    for (auto *side : {&left_, &right_}) {
+        const std::string topic_cam_info = "/evk4_" + side->camera_name + "/camera_info";
+        const std::string topic_events   = "/evk4_" + side->camera_name + "/events";
+
+        side->pub_info = nh_.advertise<sensor_msgs::CameraInfo>(topic_cam_info, 1);
+        if (publish_cd_)
+            side->pub_events = nh_.advertise<dvs_msgs::EventArray>(topic_events, 500);
+    }
+
+    // Open both cameras from this single process -- opening them from two
+    // separate processes fails on this rig (their hardware sync cable
+    // relationship appears to be process-exclusive at the HAL level).
+    while (!openCamera(left_)) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        ROS_INFO("Trying to open left camera (serial %s)...", left_.serial_number.c_str());
+    }
+    while (!openCamera(right_)) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        ROS_INFO("Trying to open right camera (serial %s)...", right_.serial_number.c_str());
+    }
+
+    for (auto *side : {&left_, &right_}) {
+        side->camera.add_runtime_error_callback(
+            [side](const Metavision::CameraException &e) { ROS_WARN("[%s] %s", side->camera_name.c_str(), e.what()); });
+
+        auto &geometry = side->camera.geometry();
+        ROS_INFO("[%s] Width:%i, Height:%i", side->camera_name.c_str(), geometry.get_width(), geometry.get_height());
+
+        side->cam_info_msg.width           = geometry.get_width();
+        side->cam_info_msg.height          = geometry.get_height();
+        side->cam_info_msg.header.frame_id = "PropheseeCamera_optical_frame";
+    }
+}
+
+PropheseeStereoPublisher::~PropheseeStereoPublisher() {
+    left_.camera.stop();
+    right_.camera.stop();
+    nh_.shutdown();
+}
+
+bool PropheseeStereoPublisher::openCamera(PropheseeStereoSide &side) {
+    try {
+        side.camera = side.serial_number.empty() ? Metavision::Camera::from_first_available() :
+                                                    Metavision::Camera::from_serial(side.serial_number);
+        return true;
+    } catch (Metavision::CameraException &e) {
+        ROS_WARN("[%s] %s", side.camera_name.c_str(), e.what());
+        return false;
+    }
+}
+
+void PropheseeStereoPublisher::startPublishing() {
+    left_.start_timestamp  = ros::Time::now();
+    right_.start_timestamp = ros::Time::now();
+
+    left_.camera.start();
+    right_.camera.start();
+
+    if (publish_cd_) {
+        publishCDEvents(left_);
+        publishCDEvents(right_);
+    }
+
+    ros::Rate loop_rate(5);
+    while (ros::ok()) {
+        for (auto *side : {&left_, &right_}) {
+            if (side->pub_info.getNumSubscribers() > 0) {
+                side->cam_info_msg.header.stamp = ros::Time::now();
+                side->pub_info.publish(side->cam_info_msg);
+            }
+        }
+        loop_rate.sleep();
+    }
+}
+
+void PropheseeStereoPublisher::publishCDEvents(PropheseeStereoSide &side) {
+    try {
+        side.camera.cd().add_callback([&side, this](const Metavision::EventCD *ev_begin, const Metavision::EventCD *ev_end) {
+            if (side.pub_events.getNumSubscribers() <= 0)
+                return;
+
+            if (ev_begin < ev_end) {
+                const unsigned int buffer_size = ev_end - ev_begin;
+                (void)buffer_size;
+
+                side.event_buffer_current_time.fromNSec(side.start_timestamp.toNSec() + (ev_begin->t * 1000.00));
+
+                if (side.event_buffer.empty()) {
+                    side.event_buffer_start_time = side.event_buffer_current_time;
+                }
+
+                auto inserter = std::back_inserter(side.event_buffer);
+                std::copy(ev_begin, ev_end, inserter);
+
+                side.event_buffer_current_time.fromNSec(side.start_timestamp.toNSec() + (ev_end - 1)->t * 1000.00);
+            }
+
+            if ((side.event_buffer_current_time - side.event_buffer_start_time) >= event_delta_t_) {
+                dvs_msgs::EventArray event_buffer_msg;
+
+                event_buffer_msg.header.stamp = side.event_buffer_current_time;
+                event_buffer_msg.height       = side.camera.geometry().get_height();
+                event_buffer_msg.width        = side.camera.geometry().get_width();
+
+                event_buffer_msg.events.resize(side.event_buffer.size());
+
+                auto buffer_msg_it = event_buffer_msg.events.begin();
+                for (const Metavision::EventCD *it = std::addressof(side.event_buffer[0]);
+                     it != std::addressof(side.event_buffer[side.event_buffer.size()]); ++it, ++buffer_msg_it) {
+                    dvs_msgs::Event &event = *buffer_msg_it;
+                    event.x                = it->x;
+                    event.y                = it->y;
+                    event.polarity         = it->p;
+                    event.ts.fromNSec(side.start_timestamp.toNSec() + (it->t * 1000.00));
+                }
+
+                side.pub_events.publish(event_buffer_msg);
+                side.event_buffer.clear();
+            }
+        });
+    } catch (Metavision::CameraException &e) {
+        ROS_WARN("[%s] %s", side.camera_name.c_str(), e.what());
+        publish_cd_ = false;
+    }
+}
+
+int main(int argc, char **argv) {
+    ros::init(argc, argv, "prophesee_ros_stereo_publisher");
+
+    PropheseeStereoPublisher sp;
+    sp.startPublishing();
+
+    ros::shutdown();
+    return 0;
+}
