<launch>
  <!-- Live stereo EVK4 rig + SBG IMU. To start drivers and pipeline together use
         roslaunch esvo2_core evk4_live_all.launch
       This file alone needs the drivers running beforehand in separate terminals:
         roslaunch prophesee_ros_driver stereo.launch
         roslaunch sbg_driver sbg_evk4_rig.launch
       (cameras publish dvs_msgs on /evk4_left|right/events; SBG publishes
       sensor_msgs/Imu directly on /imu/data, which is what esvo2_Mapping /
       esvo2_Tracking subscribe to already, so no remap is needed) -->
  <!-- Replay of a recorded bag: use_sim_time:=true, gui:=false, and optionally
       other configs / time-surface rate (see scripts/replay_eval.sh) -->
  <arg name="use_sim_time" default="false"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>
  <arg name="mapping_cfg" default="$(find esvo2_core)/cfg/mapping/mapping_evk4_AA_mapping.yaml"/>
  <arg name="tracking_cfg" default="$(find esvo2_core)/cfg/tracking/tracking_evk4_AA.yaml"/>
  <!-- Time-surface (= tracking) rate and AA window: the settings every rig
       result since 2026-09-22 was measured with. 25 Hz loses 15-30% of the
       translation, and without the window the map thins out at higher rates
       (docs/superpowers/specs/2026-09-23-realtime-pipeline-findings.md, B1/B2). -->
  <arg name="ts_rate" default="50"/>
  <arg name="aa_window_ms" default="40"/>
  <arg name="opencv_threads" default="0"/>
  <!-- Overrides of the tracking config, empty = keep the config's value:
       stillness_hold:=true|false, motion_log:=/path/motion.csv (per-frame hold inputs) -->
  <arg name="stillness_hold" default=""/>
  <arg name="motion_log" default=""/>

  <!-- Calibration folder -->
  <!-- The camera mounts were swapped before 2026-09-23 and the rig was
       recalibrated then (right camera ~0.7 deg yaw, 0.5 deg pitch, baseline
       146.6 -> 154.3 mm). Bags recorded before that (slide4_bias, the wall
       bags, the golden capture) need calibInfoDirStr:=.../calib/evk4_stereo. -->
  <arg name="calibInfoDirStr" default="$(find esvo2_core)/calib/evk4_stereo_2026-09-23"/>
  <!-- gui:=false skips rqt and rviz (headless) -->
  <arg name="gui" default="true"/>

  <node name="image_representation_left" pkg="image_representation" type="image_representation" output="screen" clear_params="true" >
    <remap from="events" to="/evk4_left/events" />
    <remap from="image" to="/evk4_left/image_raw" />
    <remap from="camera_info" to="/evk4_left/camera_info" />
    <remap from="image_representation_TS_" to="image_representation_TS_l" />
    <remap from="image_representation_negative_TS_" to="image_representation_negative_TS_l" />
    <remap from="image_representation_AA_frequency_" to="AA_left" />
    <remap from="image_representation_AA_mat_" to="AA_map" />
    <remap from="dx_image_pub_" to="dx_image_pub_l" />
    <remap from="dy_image_pub_" to="dy_image_pub_l" />

    <rosparam command="load" file="$(find image_representation)/cfg/image_representation_fast.yaml" />
    <rosparam param="calibInfoDir" subst_value="true">$(arg calibInfoDirStr)</rosparam>
    <!-- Override: the shared cfg's 100Hz target is unreachable on this rig
         (measured ~20Hz actual under load) and left, which does strictly
         more work than right (AA map + dx/dy gradients), stalls outright
         when both compete for CPU chasing an unreachable target. -->
    <param name="generation_rate_hz" value="$(arg ts_rate)" />
    <param name="aa_window_ms" value="$(arg aa_window_ms)" />
    <param name="opencv_threads" value="$(arg opencv_threads)" />
  </node>

  <node name="image_representation_right" pkg="image_representation" type="image_representation" output="screen" clear_params="true" >
    <remap from="events" to="/evk4_right/events" />
    <remap from="image" to="/evk4_right/image_raw" />
    <remap from="camera_info" to="/evk4_right/camera_info" />
    <remap from="image_representation_TS_" to="image_representation_TS_r" />

    <rosparam command="load" file="$(find image_representation)/cfg/image_representation_fast_r.yaml" />
    <rosparam param="calibInfoDir" subst_value="true">$(arg calibInfoDirStr)</rosparam>
    <param name="generation_rate_hz" value="$(arg ts_rate)" />
    <param name="aa_window_ms" value="$(arg aa_window_ms)" />
    <param name="opencv_threads" value="$(arg opencv_threads)" />
  </node>

  <!-- Mapping node -->
  <node name="esvo2_Mapping" pkg="esvo2_core" type="esvo2_Mapping" output="screen" required="true" clear_params="true">
    <remap from="time_surface_left" to="image_representation_TS_l" />
    <remap from="time_surface_right" to="image_representation_TS_r" />
    <remap from="time_surface_negative" to="image_representation_negative_TS_l" />
    <remap from="time_surface_negative_dx" to="dx_image_pub_l" />
    <remap from="time_surface_negative_dy" to="dy_image_pub_l" />
    <remap from="stamped_pose" to="/esvo2_tracking/pose_pub" />
    <remap from="events_left" to="/evk4_left/events" />
    <remap from="events_right" to="/evk4_right/events" />

    <rosparam param="dvs_frame_id">"dvs"</rosparam>
    <rosparam param="world_frame_id">"map"</rosparam>
    <rosparam param="calibInfoDir" subst_value="true">$(arg calibInfoDirStr)</rosparam>

    <rosparam command="load" file="$(arg mapping_cfg)" />
  </node>

  <!-- Tracking node -->
  <node name="esvo2_Tracking" pkg="esvo2_core" type="esvo2_Tracking" output="screen" required="true" clear_params="true">
    <remap from="time_surface_left" to="image_representation_TS_l" />
    <remap from="time_surface_right" to="image_representation_TS_r" />
    <remap from="time_surface_negative" to="image_representation_negative_TS_l" />
    <remap from="time_surface_dx" to="dx_image_pub_l" />
    <remap from="time_surface_dy" to="dy_image_pub_l" />
    <remap from="stamped_pose" to="/esvo2_tracking/pose_pub" />
    <remap from="events_left" to="/evk4_left/events" />
    <remap from="pointcloud" to="/esvo2_mapping/pointcloud_local2" />
    <remap from="imu_prediction" to="/imu/data_synced" />
    <rosparam param="dvs_frame_id">"dvs"</rosparam>
    <rosparam param="world_frame_id">"map"</rosparam>
    <rosparam param="calibInfoDir" subst_value="true">$(arg calibInfoDirStr)</rosparam>

    <rosparam command="load" file="$(arg tracking_cfg)" />
    <param if="$(eval arg('stillness_hold') != '')" name="STILLNESS_HOLD" value="$(arg stillness_hold)" type="bool" />
    <param if="$(eval arg('motion_log') != '')" name="MOTION_LOG" value="$(arg motion_log)" />
  </node>

  <!-- Visualization -->
  <group if="$(arg gui)">
    <node pkg="rqt_gui" type="rqt_gui" name="rqt_gui" args="--perspective-file $(find esvo2_core)/esvo2_system_DSEC.perspective" />
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find esvo2_core)/esvo2_system_DSEC.rviz" />
  </group>
</launch>
