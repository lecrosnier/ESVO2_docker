{
  "calibration-steps": [
    {
      "skip": false,
      "name": "eb-pattern-detection",
      "description": "Record data for EB intrinsics calibration (master / left, serial 00051860)",
      "output-dir": "CALIB_DIR/master",
      "reload": false,
      "skip-time-us": 2000000,
      "camera": {
        "slice-duration-us": 100000,
        "device-id": "00051860",
        "record": false,
        "record-dir": "CALIB_DIR/master"
      },
      "pattern-path": "CALIB_DIR/pattern.json",
      "pattern-detector": {
        "type": "blinking-chessboard"
      },
      "pattern-renderer": {
        "overlay-convex-hull": false
      }
    },
    {
      "skip": false,
      "name": "intrinsics-estimation",
      "description": "Estimate camera intrinsics (master / left)",
      "input-dir": "CALIB_DIR/master",
      "output-dir": "CALIB_DIR/master",
      "estimator": {
        "type": "pinhole",
        "flags": 130,
        "outlier-ths": 2.0
      }
    },
    {
      "skip": false,
      "name": "intrinsics-validation",
      "description": "Visual validation of camera intrinsics (master / left)",
      "input-dir": "CALIB_DIR/master"
    },
    {
      "skip": false,
