diff --git a/prophesee_ros_driver/include/prophesee_ros_driver/prophesee_ros_stereo_publisher.h b/prophesee_ros_driver/include/prophesee_ros_driver/prophesee_ros_stereo_publisher.h
new file mode 100644
index 0000000..4987dc8
--- /dev/null
+++ b/prophesee_ros_driver/include/prophesee_ros_driver/prophesee_ros_stereo_publisher.h
@@ -0,0 +1,64 @@
+/*******************************************************************
+ * File : prophesee_ros_stereo_publisher.h                         *
+ *                                                                 *
+ * Publishes both cameras of a hardware-synced EVK4 stereo pair    *
+ * from a single process. Two cameras opened via from_serial() in  *
+ * separate processes fail to open on this rig (their sync cable   *
+ * relationship appears to be process-exclusive at the HAL level), *
+ * so both must live in the same node.                             *
+ *******************************************************************/
+
+#ifndef PROPHESEE_ROS_STEREO_PUBLISHER_H_
+#define PROPHESEE_ROS_STEREO_PUBLISHER_H_
+
+#include <vector>
+
+#include <ros/ros.h>
+#include <sensor_msgs/CameraInfo.h>
+
+#include <metavision/sdk/stream/camera.h>
+
+/// \brief One camera's ROS-facing state (publishers, buffers, event batching)
+struct PropheseeStereoSide {
+    std::string serial_number;
+    std::string camera_name;
+
+    Metavision::Camera camera;
+
+    ros::Publisher pub_info;
+    ros::Publisher pub_events;
+
+    sensor_msgs::CameraInfo cam_info_msg;
+
+    std::vector<Metavision::EventCD> event_buffer;
+    ros::Time start_timestamp, event_buffer_start_time, event_buffer_current_time;
+};
+
+/// \brief Main class for the stereo ROS publisher
+///
+/// Opens both cameras of a synced EVK4 stereo pair in a single process and
+/// publishes each to its own set of topics under /prophesee/<camera_name>/.
+class PropheseeStereoPublisher {
+public:
+    PropheseeStereoPublisher();
+    ~PropheseeStereoPublisher();
+
+    /// \brief Starts both cameras and starts publishing data
+    void startPublishing();
+
+private:
+    bool openCamera(PropheseeStereoSide &side);
+    void maskPixels(PropheseeStereoSide &side, const std::string &param);
+    void limitEventRate(PropheseeStereoSide &side, int events_per_sec);
+    void publishCDEvents(PropheseeStereoSide &side);
+
+    ros::NodeHandle nh_;
+
+    PropheseeStereoSide left_;
+    PropheseeStereoSide right_;
+
+    bool publish_cd_;
+    ros::Duration event_delta_t_;
+};
+
+#endif /* PROPHESEE_ROS_STEREO_PUBLISHER_H_ */
diff --git a/prophesee_ros_driver/launch/stereo.launch b/prophesee_ros_driver/launch/stereo.launch
new file mode 100644
index 0000000..44f0364
--- /dev/null
+++ b/prophesee_ros_driver/launch/stereo.launch
@@ -0,0 +1,31 @@
+<launch>
+  <!-- Stereo EVK4 rig. Serials fixed per this specific rig:
+       00051860 = physically right camera (sync master, cabled SYNC OUT)
+       00051182 = physically left camera (sync slave, cabled SYNC IN)
+
+       Both cameras are opened from a SINGLE process (prophesee_ros_stereo_publisher):
+       opening them from two separate processes fails on this rig, apparently because
+       their hardware sync cable relationship is process-exclusive at the HAL level. -->
+  <arg name="left_serial" default="00051182" />
+  <arg name="right_serial" default="00051860" />
+  <!-- Hardware event rate cap per camera in events/s, 0 disables it (see below) -->
+  <arg name="event_rate_limit" default="4000000" />
+
+  <node name="prophesee_ros_stereo_publisher" pkg="prophesee_ros_driver" type="prophesee_ros_stereo_publisher" output="screen">
+    <param name="left_serial" type="str" value="$(arg left_serial)" />
+    <param name="right_serial" type="str" value="$(arg right_serial)" />
+    <param name="publish_cd" value="true" />
+    <!-- Hot pixels masked in the sensor, as [x, y] (max 64 per camera). Found
+         2026-09-15 by counting events per pixel: each fired 4.6M to 9M OFF
+         events/s, about 97% of the camera's output, which starved the time
+         surface nodes (images going black). Same pixels in repeated runs.
+         If a new one appears, add it here. -->
+    <rosparam param="left_masked_pixels">[[307, 456], [502, 34]]</rosparam>
+    <rosparam param="right_masked_pixels">[[596, 504]]</rosparam>
+    <!-- Hardware event rate cap per camera (IMX636 ERC), in events/s. During
+         fast motion the cameras reach 5 to 10M ev/s, more than the time
+         surface nodes can ingest, and their images go black. The sensor
+         drops events above this rate. 0 disables the cap. -->
+    <param name="event_rate_limit" type="int" value="$(arg event_rate_limit)" />
+  </node>
+</launch>
diff --git a/prophesee_ros_driver/src/prophesee_ros_stereo_publisher.cpp b/prophesee_ros_driver/src/prophesee_ros_stereo_publisher.cpp
new file mode 100644
index 0000000..5a6ee72
--- /dev/null
+++ b/prophesee_ros_driver/src/prophesee_ros_stereo_publisher.cpp
@@ -0,0 +1,247 @@
+/*******************************************************************
+ * File : prophesee_ros_stereo_publisher.cpp                       *
+ *******************************************************************/
+
+#include <algorithm>
+#include <thread>
+
+#include <ros/ros.h>
+
+#include <dvs_msgs/Event.h>
+#include <dvs_msgs/EventArray.h>
+
+#include <metavision/hal/facilities/i_digital_event_mask.h>
+#include <metavision/hal/facilities/i_erc_module.h>
+
+#include "prophesee_ros_stereo_publisher.h"
+
+PropheseeStereoPublisher::PropheseeStereoPublisher() : nh_("~") {
+    left_.camera_name  = "left";
+    right_.camera_name = "right";
+
+    nh_.getParam("left_serial", left_.serial_number);
+    nh_.getParam("right_serial", right_.serial_number);
+
+    publish_cd_ = true;
+    nh_.getParam("publish_cd", publish_cd_);
+    event_delta_t_ = ros::Duration(nh_.param<double>("event_delta_t", 100.0e-6));
+
+    for (auto *side : {&left_, &right_}) {
+        const std::string topic_cam_info = "/evk4_" + side->camera_name + "/camera_info";
+        const std::string topic_events   = "/evk4_" + side->camera_name + "/events";
+
+        side->pub_info = nh_.advertise<sensor_msgs::CameraInfo>(topic_cam_info, 1);
+        if (publish_cd_)
+            side->pub_events = nh_.advertise<dvs_msgs::EventArray>(topic_events, 500);
+    }
+
+    // Open both cameras from this single process -- opening them from two
+    // separate processes fails on this rig (their hardware sync cable
+    // relationship appears to be process-exclusive at the HAL level).
+    while (!openCamera(left_)) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        ROS_INFO("Trying to open left camera (serial %s)...", left_.serial_number.c_str());
+    }
+    while (!openCamera(right_)) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        ROS_INFO("Trying to open right camera (serial %s)...", right_.serial_number.c_str());
+    }
+
+    for (auto *side : {&left_, &right_}) {
+        side->camera.add_runtime_error_callback(
+            [side](const Metavision::CameraException &e) { ROS_WARN("[%s] %s", side->camera_name.c_str(), e.what()); });
+
+        auto &geometry = side->camera.geometry();
+        ROS_INFO("[%s] Width:%i, Height:%i", side->camera_name.c_str(), geometry.get_width(), geometry.get_height());
+
+        side->cam_info_msg.width           = geometry.get_width();
+        side->cam_info_msg.height          = geometry.get_height();
+        side->cam_info_msg.header.frame_id = "PropheseeCamera_optical_frame";
+    }
+
+    maskPixels(left_, "left_masked_pixels");
+    maskPixels(right_, "right_masked_pixels");
+
+    const int event_rate_limit = nh_.param<int>("event_rate_limit", 0);
+    limitEventRate(left_, event_rate_limit);
+    limitEventRate(right_, event_rate_limit);
+}
+
+// Caps the sensor's output with its hardware event rate controller (ERC): above
+// the target rate the sensor drops events itself. During fast motion each EVK4
+// reaches 5 to 10M ev/s, which the time surface nodes can't ingest (their
+// images go black). events_per_sec <= 0 disables the cap.
+void PropheseeStereoPublisher::limitEventRate(PropheseeStereoSide &side, int events_per_sec) {
+    auto *erc = side.camera.get_device().get_facility<Metavision::I_ErcModule>();
+    if (!erc) {
+        if (events_per_sec > 0)
+            ROS_WARN("[%s] camera has no event rate controller, event_rate_limit ignored", side.camera_name.c_str());
+        return;
+    }
+    if (events_per_sec <= 0) {
+        erc->enable(false);
+        ROS_INFO("[%s] event rate cap disabled", side.camera_name.c_str());
+        return;
+    }
+
+    const uint32_t min_rate = erc->get_min_supported_cd_event_rate();
+    const uint32_t max_rate = erc->get_max_supported_cd_event_rate();
+    const uint32_t target   = std::min(std::max(static_cast<uint32_t>(events_per_sec), min_rate), max_rate);
+    if (target != static_cast<uint32_t>(events_per_sec))
+        ROS_WARN("[%s] event_rate_limit %d outside supported [%u, %u], using %u", side.camera_name.c_str(),
+                 events_per_sec, min_rate, max_rate, target);
+
+    const bool ok = erc->set_cd_event_rate(target) && erc->enable(true);
+    if (ok && erc->is_enabled())
+        ROS_INFO("[%s] event rate capped at %u ev/s", side.camera_name.c_str(), erc->get_cd_event_rate());
+    else
+        ROS_WARN("[%s] failed to cap event rate at %u ev/s", side.camera_name.c_str(), target);
+}
+
+// Masks hot pixels in the sensor itself (IMX636 digital event mask, 64 slots),
+// so they emit no events at all. param is a list of [x, y] pairs. A single
+// hot pixel on this rig fired ~9M events/s, ~97% of the camera's output.
+void PropheseeStereoPublisher::maskPixels(PropheseeStereoSide &side, const std::string &param) {
+    XmlRpc::XmlRpcValue list;
+    if (!nh_.getParam(param, list))
+        return;
+    if (list.getType() != XmlRpc::XmlRpcValue::TypeArray) {
+        ROS_WARN("[%s] %s must be a list of [x, y] pairs, ignoring it", side.camera_name.c_str(), param.c_str());
+        return;
+    }
+
+    auto *event_mask = side.camera.get_device().get_facility<Metavision::I_DigitalEventMask>();
+    if (!event_mask) {
+        ROS_WARN("[%s] camera has no digital event mask, %s ignored", side.camera_name.c_str(), param.c_str());
+        return;
+    }
+    const auto &slots = event_mask->get_pixel_masks();
+
+    size_t slot = 0;
+    for (int i = 0; i < list.size(); ++i) {
+        XmlRpc::XmlRpcValue &p = list[i];
+        if (p.getType() != XmlRpc::XmlRpcValue::TypeArray || p.size() != 2 ||
+            p[0].getType() != XmlRpc::XmlRpcValue::TypeInt || p[1].getType() != XmlRpc::XmlRpcValue::TypeInt) {
+            ROS_WARN("[%s] %s entry %d is not an [x, y] pair of ints, skipped", side.camera_name.c_str(), param.c_str(), i);
+            continue;
+        }
+        if (slot >= slots.size()) {
+            ROS_WARN("[%s] only %zu pixel masks available, remaining %s entries ignored", side.camera_name.c_str(),
+                     slots.size(), param.c_str());
+            break;
+        }
+        const int x = static_cast<int>(p[0]);
+        const int y = static_cast<int>(p[1]);
+        slots[slot]->set_mask(x, y, true);
+
+        const auto readback = slots[slot]->get_mask();
+        if (static_cast<int>(std::get<0>(readback)) == x && static_cast<int>(std::get<1>(readback)) == y &&
+            std::get<2>(readback))
+            ROS_INFO("[%s] masked pixel (%d, %d)", side.camera_name.c_str(), x, y);
+        else
+            ROS_WARN("[%s] failed to mask pixel (%d, %d)", side.camera_name.c_str(), x, y);
+        ++slot;
+    }
+}
+
+PropheseeStereoPublisher::~PropheseeStereoPublisher() {
+    left_.camera.stop();
+    right_.camera.stop();
+    nh_.shutdown();
+}
+
+bool PropheseeStereoPublisher::openCamera(PropheseeStereoSide &side) {
+    try {
+        side.camera = side.serial_number.empty() ? Metavision::Camera::from_first_available() :
+                                                    Metavision::Camera::from_serial(side.serial_number);
+        return true;
+    } catch (Metavision::CameraException &e) {
+        ROS_WARN("[%s] %s", side.camera_name.c_str(), e.what());
+        return false;
+    }
+}
+
+void PropheseeStereoPublisher::startPublishing() {
+    left_.start_timestamp  = ros::Time::now();
+    right_.start_timestamp = ros::Time::now();
+
+    left_.camera.start();
+    right_.camera.start();
+
+    if (publish_cd_) {
+        publishCDEvents(left_);
+        publishCDEvents(right_);
+    }
+
+    ros::Rate loop_rate(5);
+    while (ros::ok()) {
+        for (auto *side : {&left_, &right_}) {
+            if (side->pub_info.getNumSubscribers() > 0) {
+                side->cam_info_msg.header.stamp = ros::Time::now();
+                side->pub_info.publish(side->cam_info_msg);
+            }
+        }
+        loop_rate.sleep();
+    }
+}
+
+void PropheseeStereoPublisher::publishCDEvents(PropheseeStereoSide &side) {
+    try {
+        side.camera.cd().add_callback([&side, this](const Metavision::EventCD *ev_begin, const Metavision::EventCD *ev_end) {
+            if (side.pub_events.getNumSubscribers() <= 0)
+                return;
+
+            if (ev_begin < ev_end) {
+                const unsigned int buffer_size = ev_end - ev_begin;
+                (void)buffer_size;
+
+                side.event_buffer_current_time.fromNSec(side.start_timestamp.toNSec() + (ev_begin->t * 1000.00));
+
+                if (side.event_buffer.empty()) {
+                    side.event_buffer_start_time = side.event_buffer_current_time;
+                }
+
+                auto inserter = std::back_inserter(side.event_buffer);
+                std::copy(ev_begin, ev_end, inserter);
+
+                side.event_buffer_current_time.fromNSec(side.start_timestamp.toNSec() + (ev_end - 1)->t * 1000.00);
+            }
+
+            if ((side.event_buffer_current_time - side.event_buffer_start_time) >= event_delta_t_) {
+                dvs_msgs::EventArray event_buffer_msg;
+
+                event_buffer_msg.header.stamp = side.event_buffer_current_time;
+                event_buffer_msg.height       = side.camera.geometry().get_height();
+                event_buffer_msg.width        = side.camera.geometry().get_width();
+
+                event_buffer_msg.events.resize(side.event_buffer.size());
+
+                auto buffer_msg_it = event_buffer_msg.events.begin();
+                for (const Metavision::EventCD *it = std::addressof(side.event_buffer[0]);
+                     it != std::addressof(side.event_buffer[side.event_buffer.size()]); ++it, ++buffer_msg_it) {
+                    dvs_msgs::Event &event = *buffer_msg_it;
+                    event.x                = it->x;
+                    event.y                = it->y;
+                    event.polarity         = it->p;
+                    event.ts.fromNSec(side.start_timestamp.toNSec() + (it->t * 1000.00));
+                }
+
+                side.pub_events.publish(event_buffer_msg);
+                side.event_buffer.clear();
+            }
+        });
+    } catch (Metavision::CameraException &e) {
+        ROS_WARN("[%s] %s", side.camera_name.c_str(), e.what());
+        publish_cd_ = false;
+    }
+}
+
+int main(int argc, char **argv) {
+    ros::init(argc, argv, "prophesee_ros_stereo_publisher");
+
+    PropheseeStereoPublisher sp;
+    sp.startPublishing();
+
+    ros::shutdown();
+    return 0;
+}
